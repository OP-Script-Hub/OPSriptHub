local selectedScript = ""
local isLoadingActive = false

-- Step 1 Click
startButton.MouseButton1Click:Connect(function()
    startFrame.Visible = false
    selectionFrame.Visible = true
end)

-- Function to start loading process
local function StartLoadingProcess(scriptName)
    selectedScript = scriptName
    selectionFrame.Visible = false
    loadingFrame.Visible = true
    selectedScriptLabel.Text = "LOADING: " .. scriptName
    isLoadingActive = true

    -- Log Messages Animation
    task.spawn(function()
        local msgs = {
            "> Synchronizing Data...",
            "> Patching Memory...",
            "> Fetching Assets...",
            "> Whitelist Verified."
        }
        while isLoadingActive do
            logLabel.Text = "<b>" .. msgs[math.random(1, #msgs)] .. "</b>"
            logLabel.RichText = true
            task.wait(math.random(1, 2))
        end
    end)

    -- Guard connection for DisplayOrder / SecureParent
    local guardConnection
    guardConnection = RunService.RenderStepped:Connect(function()
        if isLoadingActive then
            screenGui.DisplayOrder = MAX_PRIORITY
            SecureParent()
            screenGui.Enabled = true
        else
            guardConnection:Disconnect()
        end
    end)

    -- Fill Progress Bar
    local barTween = TweenService:Create(barFill, TweenInfo.new(LOADING_TIME, Enum.EasingStyle.Linear), {Size = UDim2.fromScale(1, 1)})
    barTween:Play()
    barTween.Completed:Wait()

    isLoadingActive = false
    isAnimatingBg = false

    -- Fade Out Transition
    for _, v in pairs(screenGui:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("Frame") or v:IsA("TextButton") then
            pcall(function()
                TweenService:Create(v, TweenInfo.new(1.5), {Transparency = 1}):Play()
            end)
        end
    end

    task.wait(1.7)
    screenGui:Destroy()
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)

    -- Pwede nimong ibutang diri ang code sa pag-execute sa napilion nga script:
    -- print("Successfully loaded script: " .. selectedScript)
end

